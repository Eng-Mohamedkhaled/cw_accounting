<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="cw_equity_management.EquityTransactionDashboardJS">
        <Layout display="{controlPanel: {}}" className="'o_dashboard h-100 cw-equity-dashboard-container'">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Equity Report</h2>
                <div class="text-muted">
                    <small>Period: <t t-esc="state.selectedDateFrom"/> to <t t-esc="state.selectedDateTo"/></small>
                </div>
            </div>
            <t t-set-slot="control-panel-create-button">
                <div class="d-flex align-items-center gap-2">
                    <button t-on-click="printReport" type="button" class="btn btn-primary" title="Print">Print</button>
                    <button t-on-click="exportReport" type="button" class="btn btn-success" title="Export">Export</button>
                </div>
            </t>
            <t t-set-slot="layout-actions">
                <div class="d-flex gap-1 flex-wrap align-items-center">
                    <div class="filter_date">
                        <label class="form-label mb-0 me-1">From:</label>
                        <input type="date" t-on-change="onDateFromChange" t-att-value="state.selectedDateFrom" class="form-control d-inline-block" style="width: auto;"/>
                    </div>
                    <div class="filter_date">
                        <label class="form-label mb-0 me-1">To:</label>
                        <input type="date" t-on-change="onDateToChange" t-att-value="state.selectedDateTo" class="form-control d-inline-block" style="width: auto;"/>
                    </div>
                    <Dropdown>
                        <button class="btn btn-outline-secondary">
                            <i class="fa fa-cog" /> Options
                        </button>
                        <t t-set-slot="content">
                            <div class="p-3">
                                <div class="mb-3">
                                    <label class="form-label mb-2">Transaction Type:</label>
                                    <select t-on-change="onTransactionTypeChange" t-att-value="state.transactionType" class="form-control">
                                        <option value="all">All Transactions</option>
                                        <option value="contribution">Capital Contributions</option>
                                        <option value="withdrawal">Withdrawals</option>
                                    </select>
                                </div>
                                <div class="mb-0">
                                    <label class="form-label mb-2">Partner:</label>
                                    <div class="input-group">
                                        <input
                                            type="text"
                                            t-on-input="onPartnerSearchInput"
                                            t-att-value="state.selectedPartnerName"
                                            class="form-control"
                                            placeholder="All partners (search to select specific)"
                                            autocomplete="off"
                                        />
                                        <t t-if="state.selectedPartnerName">
                                            <button type="button" class="btn btn-outline-secondary" t-on-click="clearPartnerSelection">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </t>
                                    </div>
                                    <div t-if="state.showPartnerDropdown" class="dropdown-menu show mt-1" style="position: static; display: block; max-height: 200px; overflow-y: auto;">
                                        <t t-foreach="state.filteredPartners" t-as="partner" t-key="partner.id">
                                            <a href="#"
                                               class="dropdown-item py-2"
                                               t-on-click="onPartnerSelect"
                                               t-att-data-partner-id="partner.id">
                                                <t t-if="partner.ref"><t t-esc="partner.ref"/> - </t><t t-esc="partner.name"/>
                                            </a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </Dropdown>
                </div>
            </t>
            <t t-set-slot="control-panel-navigation-additional">
                <button t-on-click="refreshReport" type="button" class="btn btn-outline-secondary" title="Refresh">
                    <i class="fa fa-refresh"></i> Refresh
                </button>
            </t>
            
            <div class="o_content o_dashboard_container h-100 w-100">
                <t t-if="state.isLoading">
                    <div class="d-flex justify-content-center align-items-center h-50">
                        <div class="spinner-border cw-equity-spinner" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </t>

                <t t-if="!state.isLoading">
                    <!-- Equity Summary Section -->
                    <t t-if="state.equityInfo.length > 0">
                        <div class="card mb-4 cw-equity-summary-card">
                            <div class="card-header cw-equity-summary-header">
                                <h3 class="card-title mb-0">Current Equity Summary</h3>
                            </div>
                            <div class="card-body cw-equity-summary-body">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover cw-equity-summary-table">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Partner</th>
                                                <th class="text-end">Capital Account</th>
                                                <th class="text-end">Drawing Account</th>
                                                <th class="text-end">Current Equity</th>
                                                <th class="text-end">After Profit and Loss</th>
                                                <th class="text-end">Available for Withdrawal</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.equityInfo" t-as="equity" t-key="equity.partner_id">
                                                <tr class="cw-equity-summary-row">
                                                    <td><t t-esc="equity.partner_name"/></td>
                                                    <td class="text-end">
                                                        <t t-esc="formatCurrency(equity.equity_account_balance)"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-esc="formatCurrency(equity.drawing_account_balance)"/>
                                                    </td>
                                                    <td t-attf-class="text-end #{equity.current_equity >= 0 ? 'text-success' : 'text-danger'}">
                                                        <t t-esc="formatCurrency(equity.current_equity)"/>
                                                    </td>
                                                    <td t-attf-class="text-end #{equity.current_equity_after_pl >= 0 ? 'text-success' : 'text-danger'}">
                                                        <t t-esc="formatCurrency(equity.current_equity_after_pl)"/>
                                                    </td>
                                                    <td t-attf-class="text-end #{equity.available_for_withdrawal >= 0 ? 'text-success' : 'text-danger'}">
                                                        <t t-esc="formatCurrency(equity.available_for_withdrawal)"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <!-- Summary Row -->
                                            <tr class="table-active fw-bold cw-equity-summary-total-row">
                                                <td>Total</td>
                                                <td class="text-end">
                                                    <t t-esc="formatCurrency(state.equityInfo.reduce((sum, e) => sum + e.equity_account_balance, 0))"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="formatCurrency(state.equityInfo.reduce((sum, e) => sum + e.drawing_account_balance, 0))"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="formatCurrency(state.equityInfo.reduce((sum, e) => sum + e.current_equity, 0))"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="formatCurrency(state.equityInfo.reduce((sum, e) => sum + e.current_equity_after_pl, 0))"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="formatCurrency(state.equityInfo.reduce((sum, e) => sum + e.available_for_withdrawal, 0))"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Transaction Details Section -->
                    <div class="card cw-equity-transactions-card">
                        <div class="card-header cw-equity-transactions-header">
                            <h3 class="card-title mb-0">Transaction Details</h3>
                        </div>
                        <div class="card-body cw-equity-transactions-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover cw-equity-transactions-table">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Date</th>
                                            <th>Partner</th>
                                            <th>Type</th>
                                            <th class="text-end">Amount</th>
                                            <th>Status</th>
                                            <th>Description</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.transactions" t-as="trans" t-key="trans.id">
                                            <tr class="cw-equity-transaction-row">
                                                <td><t t-esc="trans.date"/></td>
                                                <td><t t-esc="trans.partner_name"/></td>
                                                <td>
                                                    <t t-esc="trans.transaction_type.charAt(0).toUpperCase() + trans.transaction_type.slice(1)" />
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="formatCurrency(trans.amount)"/>
                                                </td>
                                                <td t-attf-class="#{trans.state === 'draft' ? 'text-muted' : trans.state === 'posted' ? 'text-success fw-bold' : 'text-danger'}">
                                                    <t t-esc="trans.state.charAt(0).toUpperCase() + trans.state.slice(1)"/>
                                                </td>
                                                <td>
                                                    <t t-if="trans.move_id">
                                                        <a t-att-href="'/web#id=' + trans.move_id + '&amp;model=account.move'">
                                                            <t t-esc="trans.description"/>
                                                        </a>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="trans.description"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                        <!-- Summary Row -->
                                        <tr class="table-active fw-bold cw-equity-transactions-total-row">
                                            <td colspan="3">Total</td>
                                            <td class="text-end">
                                                <t t-esc="formatCurrency(state.transactions.reduce((sum, t) => sum + t.amount, 0))"/>
                                            </td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </Layout>
    </t>

</templates>