<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="cw_equity_management.EquityTransactionDashboard">
        <Layout display="{controlPanel: {}}" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-create-button">
                <div class="d-flex align-items-center gap-2">
                    <button t-on-click="printReport" type="button" class="btn btn-primary" title="Print">Print</button>
                    <button t-on-click="exportReport" type="button" class="btn btn-success" title="Export">Export</button>
                </div>
            </t>
            <t t-set-slot="layout-actions">
                <div class="d-flex gap-1 flex-wrap align-items-center">
                    <div class="filter_date">
                        <label class="form-label mb-0 me-1">From:</label>
                        <input type="date" t-on-change="onDateFromChange" t-att-value="state.selectedDateFrom" class="form-control d-inline-block" style="width: auto;"/>
                    </div>
                    <div class="filter_date">
                        <label class="form-label mb-0 me-1">To:</label>
                        <input type="date" t-on-change="onDateToChange" t-att-value="state.selectedDateTo" class="form-control d-inline-block" style="width: auto;"/>
                    </div>
                    <Dropdown>
                        <button class="btn btn-outline-secondary">
                            <i class="fa fa-cog" /> Options
                        </button>
                        <t t-set-slot="content">
                            <div class="p-3">
                                <div class="mb-0">
                                    <label class="form-label mb-2">Partner:</label>
                                    <div class="input-group">
                                        <input
                                            type="text"
                                            t-on-input="onPartnerSearchInput"
                                            t-att-value="state.selectedPartnerName"
                                            class="form-control"
                                            placeholder="All partners (search to select specific)"
                                            autocomplete="off"
                                        />
                                        <t t-if="state.selectedPartnerName">
                                            <button type="button" class="btn btn-outline-secondary" t-on-click="clearPartnerSelection">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </t>
                                    </div>
                                    <div t-if="state.showPartnerDropdown" class="dropdown-menu show mt-1" style="position: static; display: block; max-height: 200px; overflow-y: auto;">
                                        <t t-foreach="state.filteredPartners" t-as="partner" t-key="partner.id">
                                            <a href="#"
                                               class="dropdown-item py-2"
                                               t-on-click="onPartnerSelect"
                                               t-att-data-partner-id="partner.id">
                                                <t t-if="partner.ref"><t t-esc="partner.ref"/> - </t><t t-esc="partner.name"/>
                                            </a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </Dropdown>
                </div>
            </t>
            <t t-set-slot="control-panel-navigation-additional">
                <button t-on-click="refreshReport" type="button" class="btn btn-outline-secondary" title="Refresh">
                    <i class="fa fa-refresh"></i> Refresh
                </button>
            </t>
            <div t-ref="report_target" class="o_content o_dashboard_container h-100 w-100"/>
        </Layout>
    </t>

</templates>