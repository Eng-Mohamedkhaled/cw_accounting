<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="equity_transaction_report">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">

                <div class="page">

                    <div style="height: 30px;"></div>

                    <h2 class="text-center">Equity Transactions Report</h2>
                    <p class="text-center">
                        <strong>Period:</strong>
                        <t t-esc="date_from"/> to <t t-esc="date_to"/>
                    </p>
                    <div style="height: 30px;"></div>


                    <style>
                        table.equity_transactions {
                            width: 100%;               /* Set width to 100% of screen */
                            margin: 20px auto;        /* Center horizontally and give some top/bottom space */
                            border-collapse: collapse;
                            font-size: 15px;

                            /* Box styling */
                            border: 2px solid #888888;
                            border-radius: 8px;                /* Rounded corners */
                            box-shadow: 2px 2px 12px rgba(0,0,0,0.1); /* Subtle shadow */
                            background-color: #ffffff;         /* White background inside the box */
                        }
                        table.equity_transactions th,
                        table.equity_transactions td {
                            padding: 10px 15px !important;  /* Ensures spacing inside cells */
                        }

                        table.equity_transactions th {
                            border-bottom: 1px solid #000;
                            padding: 6px;
                            text-align: left;
                        }
                        table.equity_transactions td {
                            padding: 4px 6px;
                        }

                        /* Numeric alignment */
                        .num {
                            text-align: right;
                        }

                        /* Status colors */
                        .status-draft { color: #888888; }
                        .status-posted { color: #28a745; font-weight: bold; }
                        .status-cancelled { color: #dc3545; }

                        /* Highlight for totals */
                        .total-row {
                            background: #f0f0f0;
                            font-weight: bold;
                            border-top: 2px solid #000;
                        }

                        /* Responsive design */
                        @media (max-width: 768px) {
                            table.equity_transactions {
                                font-size: 12px;
                            }
                        }
                    </style>

                    <table class="equity_transactions">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Partner</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Description</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="transactions" t-as="trans">
                                <tr>
                                    <td><t t-esc="trans['date']"/></td>
                                    <td><t t-esc="trans['partner_name']"/></td>
                                    <td>
                                        <t t-if="trans['transaction_type'] == 'contribution'">Contribution</t>
                                        <t t-elif="trans['transaction_type'] == 'withdrawal'">Withdrawal</t>
                                        <t t-else=""><t t-esc="trans['transaction_type']"/></t>
                                    </td>
                                    <td class="num"><t t-esc="'{:,.2f}'.format(trans['amount'])"/></td>
                                    <td t-attf-class="status-#{trans['state']}"><t t-esc="trans['state'].title()"/></td>
                                    <td><t t-esc="trans['description']"/></td>
                                </tr>
                            </t>
                            
                            <!-- Summary row -->
                            <tr class="total-row">
                                <td colspan="3"><strong>Total</strong></td>
                                <td class="num">
                                    <t t-esc="'{:,.2f}'.format(sum([t['amount'] for t in transactions]))"/>
                                </td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>

                    <p id="lang-info" style="text-align:center; font-size:12px; color:#666;"></p>

                </div>

            </t>
        </t>

    </template>

</odoo>