<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="equity_transaction_report_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">

                    <!-- ================= HEADER ================= -->
                    <h2 class="text-center" style="color: #243742;">
                        <span t-esc="res_company.name"/> – Equity Transactions Report
                    </h2>

                    <div class="row mt16 mb16">
                        <div class="col-12">
                            <strong>Period:</strong>
                            <p><t t-esc="date_from"/> to <t t-esc="date_to"/></p>
                        </div>
                    </div>

                    <!-- ================= STYLES ================= -->
                    <style>
                        .page {
                            font-family: Arial, sans-serif;
                            font-size: 11px;
                        }

                        table.es {
                            width: 100%;
                            margin-top: 10px;
                            margin-bottom: 20px;  /* Space between tables */
                            border-collapse: collapse;
                        }

                        table.et {
                            width: 100%;
                            margin-top: 10px;
                            border-collapse: collapse;
                        }

                        table.es td,
                        table.es th,
                        table.et td,
                        table.et th {
                            border: 1px solid #000;
                            padding: 5px;
                        }

                        table.es th,
                        table.et th {
                            background-color: #e6e6e6;
                            font-weight: bold;
                            text-align: center;
                        }

                        table.es td,
                        table.et td {
                            vertical-align: middle;
                        }

                        table.es td.num,
                        table.et td.num {
                            text-align: right;
                            white-space: nowrap;
                        }

                        /* STATUS COLORS */
                        .status-draft { color: #888888; }
                        .status-posted { color: #28a745; font-weight: bold; }
                        .status-cancelled { color: #dc3545; }

                        /* TOTAL ROW */
                        .total-row {
                            background: #f0f0f0;
                            font-weight: bold;
                            border-top: 2px solid #000;
                        }

                        /* Equity summary specific styles */
                        .equity-positive { color: #28a745; font-weight: bold; }
                        .equity-negative { color: #dc3545; font-weight: bold; }

                        table.et tr:nth-child(even),
                        table.es tr:nth-child(even) {
                            background-color: #f9f9f9;
                        }

                        /* Repeat header on every PDF page */
                        thead {
                            display: table-header-group;
                        }

                        tbody {
                            display: table-row-group;
                        }

                        .wrap {
                            white-space: normal;
                        }

                        /* Prevent row splitting */
                        tr {
                            page-break-inside: avoid;
                        }
                    </style>

                    <!-- Equity Summary Table -->
                    <t t-if="equity_info">
                        <h3>Current Equity Summary</h3>
                        <table class="es">
                            <thead>
                                <tr>
                                    <th style="width: 20%;">Partner</th>
                                    <th style="width: 12%;">Capital Account</th>
                                    <th style="width: 12%;">Drawing Account</th>
                                    <th style="width: 12%;">Current Equity</th>
                                    <th style="width: 17%;">After Profit and Loss</th>
                                    <th style="width: 27%;">Available for Withdrawal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="equity_info" t-as="equity">
                                    <tr>
                                        <td class="wrap">
                                            <t t-esc="equity['partner_name']"/>
                                        </td>
                                        <td class="num">
                                            <t t-esc="equity['equity_account_balance']"
                                               t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="num">
                                            <t t-esc="equity['drawing_account_balance']"
                                               t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="num" t-attf-class="equity-#{'positive' if equity['current_equity'] >= 0 else 'negative'}">
                                            <t t-esc="equity['current_equity']"
                                               t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="num" t-attf-class="equity-#{'positive' if equity['current_equity_after_pl'] >= 0 else 'negative'}">
                                            <t t-esc="equity['current_equity_after_pl']"
                                               t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="num" t-attf-class="equity-#{'positive' if equity['available_for_withdrawal'] >= 0 else 'negative'}">
                                            <t t-esc="equity['available_for_withdrawal']"
                                               t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Summary row for equity -->
                                <tr class="total-row">
                                    <td class="wrap"><strong>Total</strong></td>
                                    <td class="num">
                                        <t t-esc="sum([e['equity_account_balance'] for e in equity_info])"
                                           t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="num">
                                        <t t-esc="sum([e['drawing_account_balance'] for e in equity_info])"
                                           t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="num">
                                        <t t-esc="sum([e['current_equity'] for e in equity_info])"
                                           t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="num">
                                        <t t-esc="sum([e['current_equity_after_pl'] for e in equity_info])"
                                           t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="num">
                                        <t t-esc="sum([e['available_for_withdrawal'] for e in equity_info])"
                                           t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <!-- Transaction Details Table -->
                    <table class="et">
                        <thead>
                            <tr>
                                <th style="width: 10%;">Date</th>
                                <th style="width: 20%;">Partner</th>
                                <th style="width: 15%;">Type</th>
                                <th style="width: 15%;">Amount</th>
                                <th style="width: 10%;">Status</th>
                                <th style="width: 30%;">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="transactions" t-as="trans">
                                <tr>
                                    <td class="wrap">
                                        <t t-esc="trans['date']"/>
                                    </td>
                                    <td class="wrap">
                                        <t t-esc="trans['partner_name']"/>
                                    </td>
                                    <td class="wrap">
                                        <t t-esc="trans['transaction_type'].title()"/>
                                    </td>
                                    <td class="num">
                                        <t t-esc="trans['amount']"
                                           t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="wrap">
                                        <span t-attf-class="status-#{trans['state']}">
                                            <t t-esc="trans['state'].title()"/>
                                        </span>
                                    </td>
                                    <td class="wrap">
                                        <t t-if="trans['move_id']">
                                            <a t-att-href="'/web#id=' + str(trans['move_id']) + '&amp;model=account.move'" target="_blank">
                                                <t t-esc="trans['description']"/>
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="trans['description']"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>

                            <!-- Summary row -->
                            <tr class="total-row">
                                <td class="wrap"><strong>Total</strong></td>
                                <td></td>
                                <td></td>
                                <td class="num">
                                    <t t-esc="sum([t['amount'] for t in transactions])"
                                       t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ================= FOOTER ================= -->
                    <div class="mt24">
                        <p>
                            <strong>Report generated on:</strong>
                            <t t-esc="time.strftime('%Y-%m-%d %H:%M:%S')"/>
                        </p>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>