<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record rules for multi-company isolation -->
        <record id="equity_ownership_rule" model="ir.rule">
            <field name="name">Equity Ownership Multi-Company Rule</field>
            <field name="model_id" ref="model_equity_ownership"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="equity_transaction_rule" model="ir.rule">
            <field name="name">Equity Transaction Multi-Company Rule</field>
            <field name="model_id" ref="model_equity_transaction"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="equity_allocation_rule" model="ir.rule">
            <field name="name">Equity Allocation Multi-Company Rule</field>
            <field name="model_id" ref="model_equity_allocation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>