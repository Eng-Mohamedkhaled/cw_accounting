<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master Ownership List View -->
    <record id="view_equity_ownership_master_tree" model="ir.ui.view">
        <field name="name">equity.ownership.master.tree</field>
        <field name="model">equity.ownership.master</field>
        <field name="arch" type="xml">
            <list string="Master Ownership Structures">
                <field name="name"/>
                <field name="company_id"/>
                <field name="total_percentage"/>
                <field name="status"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>

    <!-- Master Ownership Form View -->
    <record id="view_equity_ownership_master_form" model="ir.ui.view">
        <field name="name">equity.ownership.master.form</field>
        <field name="model">equity.ownership.master</field>
        <field name="arch" type="xml">
            <form string="Master Ownership Structure">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" 
                            invisible="status != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight" 
                            invisible="status != 'confirmed'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" 
                            invisible="status == 'draft'"/>
                    <button name="action_archive" type="object" string="Archive" 
                            invisible="status == 'archived'"/>
                    <button name="action_create_individual_ownerships" type="object" string="Create Individual Records" 
                            invisible="status not in ('confirmed', 'active')" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="total_percentage"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Ownership Lines">
                            <field name="owners_line_ids" widget="many2many" >
                                <list >
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="percentage"/>
                                    <field name="equity_account_id" domain="[('company_ids', 'in', parent.company_id), ('account_type', '=', 'equity')]"/>
                                </list>
                                <form string="Equity Ownership Line">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="percentage"/>
                        </group>
                        <group>
                            <field name="equity_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
                            </field>
                        </page>
                        
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Master Ownership -->
    <record id="action_equity_ownership_master" model="ir.actions.act_window">
        <field name="name">Master Ownership Structures</field>
        <field name="res_model">equity.ownership.master</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first master ownership structure
            </p><p>
                Define equity ownership for multiple partners in your companies.
            </p>
        </field>
    </record>
</odoo>