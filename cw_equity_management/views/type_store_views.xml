<odoo>

    <!-- Standalone view for equity account types settings -->
    <record id="equity_management_config_settings_view_form"
            model="ir.ui.view">
        <field name="name">equity.management.config.settings.form</field>
        <field name="model">equity.management.config.settings</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group >
                        <field name="allowed_account_type_ids" widget="many2many_tags"/>
                        <!-- <div class="text-muted">
                            Select which account types are allowed for posting in equity transactions.
                        </div> -->
                    </group>
                    <footer>
                        <button string="Apply" name="execute" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inherited view that adds to the main settings -->
    <record id="res_config_settings_view_form_inherit_account_type"
            model="ir.ui.view">
        <field name="name">res.config.settings.account.type.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
           <xpath expr="//app[@name='account']" position="inside">
                <div class="app_settings_block" data-string="Equity Management" string="Equity Management" groups="account.group_account_manager">
                    <h2>Account Types</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <label for="allowed_account_type_ids"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <field name="allowed_account_type_ids" widget="many2many_tags"/>
                                <div class="text-muted">
                                    Select which account types are allowed for posting.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Action to open the equity management settings -->
    <record id="action_type_store" model="ir.actions.act_window">
        <field name="name">Equity Account Types</field>
        <field name="res_model">equity.management.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>