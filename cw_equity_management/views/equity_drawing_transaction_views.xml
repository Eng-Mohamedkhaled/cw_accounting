<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Drawing Transaction List View -->
    <record id="view_equity_drawing_transaction_tree" model="ir.ui.view">
        <field name="name">equity.drawing.transaction.tree</field>
        <field name="model">equity.transaction</field>
        <field name="arch" type="xml">
            <list string="Owner Drawings">
                <field name="partner_id" string="Partner"/>
                <field name="company_id" string="Company" groups="base.group_system"/>
                <field name="amount" string="Amount"/>
                <field name="date" string="Date"/>
                <field name="reference" string="Reference"/>
                <field name="state" string="Status" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Drawing Transaction Form View -->
    <record id="view_equity_drawing_transaction_form" model="ir.ui.view">
        <field name="name">equity.drawing.transaction.form</field>
        <field name="model">equity.transaction</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <form string="Drawing Transaction">
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight"
                            invisible="state != 'draft' or transaction_type == 'asset_contribution' and not splits_configured"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'posted'"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Posted" invisible="state != 'posted'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entry"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not move_id">
                            <field name="move_name" string="Journal Entry" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="transaction_type" invisible="1"/>
                            <field name="reference"/>
                            <field name="partner_id" required="True" options="{'no_create': True}"/>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_system"/>
                        </group>
                        <group>
                            <field name="amount" readonly="1"/>
                            <field name="date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Accounts">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Splits" invisible="transaction_type != 'asset_contribution'">
                            <group>
                                <field name="splits_configured" invisible="1"/>
                                <div invisible="splits_configured == True">
                                    <h3 class="text-warning">Asset contribution splits not configured!</h3>
                                    <p>Please configure how to split this asset contribution among equity owners.</p>
                                </div>
                            </group>
                            <field name="split_line_ids" invisible="transaction_type != 'asset_contribution'">
                                <list editable="bottom" decoration-danger="percentage &lt; 0 or percentage &gt; 100 or manual_amount &lt; 0">
                                    <field name="partner_id" options="{'no_create': True}"/>
                                    <field name="split_type" widget="radio"/>
                                    <field name="percentage" invisible="split_type != 'percentage'" required="split_type == 'percentage'"/>
                                    <field name="manual_amount" invisible="split_type != 'manual'" required="split_type == 'manual'"/>
                                    <field name="calculated_amount" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <group>
                                <field name="description" nolabel="1" placeholder="Optional notes..."/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <!-- Action for Drawing Transactions -->
    <record id="action_equity_drawing_transaction" model="ir.actions.act_window">
        <field name="name">Owner Drawings</field>
        <field name="res_model">equity.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('transaction_type', '=', 'withdrawal')]</field>
        <field name="context">{'default_transaction_type': 'withdrawal'}</field>
        <field name="view_id" ref="view_equity_drawing_transaction_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first drawing transaction
            </p><p>
                Record owner withdrawals.
            </p>
        </field>
    </record>
</odoo>