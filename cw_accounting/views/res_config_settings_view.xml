<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cw_account_codes_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cw.account.codes.only</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Account Codes">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group  col="2">
                        <group string="Assets">
                            <field name="cw_base_code_asset_cash"/>
                            <field name="cw_base_code_asset_receivable"/>
                            <field name="cw_base_code_asset_current"/>
                            <field name="cw_base_code_asset_non_current"/>
                            <field name="cw_base_code_asset_prepayments"/>
                            <field name="cw_base_code_asset_fixed"/>
                        </group>
                        <group string="Liabilities">
                            <field name="cw_base_code_liability_payable"/>
                            <field name="cw_base_code_liability_credit_card"/>
                            <field name="cw_base_code_liability_current"/>
                            <field name="cw_base_code_liability_non_current"/>
                        </group>
                        <group string="Equity">
                            <field name="cw_base_code_equity"/>
                            <field name="cw_base_code_equity_unaffected"/>
                        </group>
                        <group string="Income">
                            <field name="cw_base_code_income"/>
                            <field name="cw_base_code_income_other"/>
                        </group>
                        <group string="Expenses">
                            <field name="cw_base_code_expense"/>
                            <field name="cw_base_code_expense_other"/>
                            <field name="cw_base_code_expense_depreciation"/>
                            <field name="cw_base_code_expense_direct_cost"/>
                        </group>
                        <group string="Off Balance">
                            <field name="cw_base_code_off_balance"/>
                        </group>
                    </group>
                    <div class="mt12 d-flex gap-2">
                        <button name="action_apply_account_codes" type="object" class="btn-primary" string="Apply Account Codes"/>
                        <button name="action_reset_account_code_defaults" type="object" class="btn-secondary" string="Reset to Defaults"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cw_account_codes_settings" model="ir.actions.act_window">
        <field name="name">Account Codes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cw_account_codes_settings_view_form"/>
        <field name="target">current</field>
        <field name="context">{'module': 'account', 'bin_size': False}</field>
    </record>

    <record id="cw_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cw.account.codes</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Account Code Prefixes" name="cw_account_code_prefixes" groups="account.group_account_manager">
                    <setting string="Account Codes" company_dependent="1"
                             help="Define the base code prefix for each account type. Codes will be assigned sequentially from each prefix.">
                        <div class="content-group">
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_asset_cash" class="o_light_label"/>
                                    <field name="cw_base_code_asset_cash"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_asset_receivable" class="o_light_label"/>
                                    <field name="cw_base_code_asset_receivable"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_asset_current" class="o_light_label"/>
                                    <field name="cw_base_code_asset_current"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_asset_non_current" class="o_light_label"/>
                                    <field name="cw_base_code_asset_non_current"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_asset_prepayments" class="o_light_label"/>
                                    <field name="cw_base_code_asset_prepayments"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_asset_fixed" class="o_light_label"/>
                                    <field name="cw_base_code_asset_fixed"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_liability_payable" class="o_light_label"/>
                                    <field name="cw_base_code_liability_payable"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_liability_credit_card" class="o_light_label"/>
                                    <field name="cw_base_code_liability_credit_card"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_liability_current" class="o_light_label"/>
                                    <field name="cw_base_code_liability_current"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_liability_non_current" class="o_light_label"/>
                                    <field name="cw_base_code_liability_non_current"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_equity" class="o_light_label"/>
                                    <field name="cw_base_code_equity"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_equity_unaffected" class="o_light_label"/>
                                    <field name="cw_base_code_equity_unaffected"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_income" class="o_light_label"/>
                                    <field name="cw_base_code_income"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_income_other" class="o_light_label"/>
                                    <field name="cw_base_code_income_other"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_expense" class="o_light_label"/>
                                    <field name="cw_base_code_expense"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_expense_other" class="o_light_label"/>
                                    <field name="cw_base_code_expense_other"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_expense_depreciation" class="o_light_label"/>
                                    <field name="cw_base_code_expense_depreciation"/>
                                </div>
                                <div class="col-lg-6">
                                    <label for="cw_base_code_expense_direct_cost" class="o_light_label"/>
                                    <field name="cw_base_code_expense_direct_cost"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-6">
                                    <label for="cw_base_code_off_balance" class="o_light_label"/>
                                    <field name="cw_base_code_off_balance"/>
                                </div>
                            </div>
                            <div class="mt12 d-flex gap-2">
                                <button name="action_apply_account_codes" type="object" class="btn-secondary" string="Apply Account Codes"/>
                                <button name="action_reset_account_code_defaults" type="object" class="btn-link" string="Reset to Defaults"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
